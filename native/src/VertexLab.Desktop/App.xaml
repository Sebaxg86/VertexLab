<Application x:Class="VertexLab.Desktop.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" StartupUri="MainWindow.xaml">
<Application.Resources>
<Style TargetType="ScrollBar"><Setter Property="Width" Value="9"/><Setter Property="Background" Value="#15161B"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Grid Background="{TemplateBinding Background}"><Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="{TemplateBinding Orientation}"><Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0"/></Track.DecreaseRepeatButton><Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="#4A4450" CornerRadius="2" Margin="2"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0"/></Track.IncreaseRepeatButton></Track></Grid></ControlTemplate></Setter.Value></Setter></Style>
<FontFamily x:Key="DisplayFont">pack://application:,,,/Assets/#Barlow Condensed</FontFamily>
<FontFamily x:Key="NumberFont">pack://application:,,,/Assets/#Rajdhani</FontFamily>
<Style TargetType="ComboBox"><Setter Property="Background" Value="#202127"/><Setter Property="Foreground" Value="#F4F5F7"/><Setter Property="BorderBrush" Value="#45414A"/><Setter Property="Padding" Value="8,4"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid><ToggleButton x:Name="Toggle" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" IsChecked="{Binding IsDropDownOpen,RelativeSource={RelativeSource TemplatedParent},Mode=TwoWay}" Focusable="False"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"><TextBlock Text="⌄" Foreground="#B5BFCD" HorizontalAlignment="Right" Margin="0,0,8,0" VerticalAlignment="Center"/></Border></ControlTemplate></ToggleButton.Template></ToggleButton><ContentPresenter IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" Margin="8,4,24,4" VerticalAlignment="Center"/><Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" PopupAnimation="Slide"><Border Background="#17181D" BorderBrush="#4A424D" BorderThickness="1" MinWidth="{Binding ActualWidth,RelativeSource={RelativeSource TemplatedParent}}"><ScrollViewer MaxHeight="300"><ItemsPresenter/></ScrollViewer></Border></Popup></Grid></ControlTemplate></Setter.Value></Setter></Style>
<Style TargetType="ComboBoxItem"><Setter Property="Foreground" Value="#F4F5F7"/><Setter Property="Padding" Value="10,7"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="Item" Background="#17181D" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Item" Property="Background" Value="#4A202E"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Item" Property="Background" Value="#33212B"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
<Style TargetType="Slider"><Setter Property="Foreground" Value="#FF3954"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider"><Grid Height="22" Background="Transparent"><Track x:Name="PART_Track" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}"><Track.DecreaseRepeatButton><RepeatButton Command="Slider.DecreaseLarge" Opacity=".45"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="#FF3954" Height="3"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton><Track.Thumb><Thumb Width="12" Height="12"><Thumb.Template><ControlTemplate TargetType="Thumb"><Ellipse Fill="#FF3954"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton Command="Slider.IncreaseLarge" Opacity=".35"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="#697382" Height="3"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton></Track></Grid></ControlTemplate></Setter.Value></Setter></Style>

<SolidColorBrush x:Key="Panel" Color="#101114"/><SolidColorBrush x:Key="Line" Color="#303036"/><SolidColorBrush x:Key="Accent" Color="#FF344C"/>
<Style TargetType="Window"><Setter Property="Background" Value="#09090C"/><Setter Property="Foreground" Value="#F4F1F3"/><Setter Property="FontFamily" Value="{StaticResource NumberFont}"/><Setter Property="FontSize" Value="14"/></Style>
<Style TargetType="Button"><Setter Property="Background" Value="#242429"/><Setter Property="Foreground" Value="#F4F1F3"/><Setter Property="BorderBrush" Value="#45454D"/><Setter Property="Padding" Value="14,9"/><Setter Property="Margin" Value="4"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Box" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="#FF344C"/><Setter TargetName="Box" Property="Background" Value="#3A2029"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Box" Property="Opacity" Value=".4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
<Style TargetType="TextBox"><Setter Property="Background" Value="#17171C"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#45454D"/><Setter Property="Padding" Value="9"/><Setter Property="Margin" Value="4"/></Style>
<Style TargetType="PasswordBox"><Setter Property="Background" Value="#17171C"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#45454D"/><Setter Property="Padding" Value="9"/><Setter Property="Margin" Value="4"/></Style>
<Style TargetType="CheckBox"><Setter Property="Foreground" Value="#F4F1F3"/><Setter Property="Margin" Value="8"/></Style>
<Style TargetType="ListBox"><Setter Property="Background" Value="#111115"/><Setter Property="Foreground" Value="#F4F1F3"/><Setter Property="BorderThickness" Value="0"/><Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/><Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/><Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/></Style>
<Style TargetType="ListBoxItem"><Setter Property="Padding" Value="10"/><Setter Property="Margin" Value="0,0,0,4"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Box" Background="#17171C" BorderBrush="#28282E" BorderThickness="0,0,0,1" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="Background" Value="#291C23"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="#FF344C"/><Setter TargetName="Box" Property="Background" Value="#321B25"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
</Application.Resources></Application>