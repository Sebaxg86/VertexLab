<Border Grid.Row="2" Style="{StaticResource Card}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><WrapPanel Margin="10,6"><TextBlock Text="Recorrido" Style="{StaticResource Heading}" VerticalAlignment="Center" Margin="0,0,7,0"/><Border Style="{StaticResource ReadingBadge}" Margin="3,0"><TextBlock x:Name="MapSpeed" Text="— km/h" Style="{StaticResource ReadingText}"/></Border><Border Style="{StaticResource ReadingBadge}" Margin="3,0"><TextBlock x:Name="MapDistance" Text="— m" Style="{StaticResource ReadingText}"/></Border><Button Content="−" Click="MapOut" Padding="6,2"/><Button Content="+" Click="MapIn" Padding="6,2"/><Button Click="FitRoute" ToolTip="Encuadrar" Padding="6,2"><local:RaceIcon Kind="fit" Width="16" Height="16"/></Button></WrapPanel><local:SeriesView x:Name="Route" Grid.Row="1" IsMap="True"/></Grid><Border Grid.Column="1" BorderBrush="#292A30" BorderThickness="1,0,0,0"><DockPanel><TextBlock DockPanel.Dock="Top" Text="VUELTAS / Δ MEJOR" FontSize="11" FontWeight="Bold" Foreground="#AAB3C1" Margin="12"/><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="LapSummary" Margin="6,0"/></ScrollViewer></DockPanel></Border></Grid></Border>
</Grid></Grid>
