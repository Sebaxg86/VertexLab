<Window x:Class="VertexLab.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:VertexLab.Desktop" Style="{StaticResource {x:Type Window}}" Title="VertexLab Desktop · Desarrollo" Width="1440" Height="920" MinWidth="1080" MinHeight="720" Loaded="WindowLoaded" Closed="WindowClosed">
<Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="68"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="95"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<Grid><Grid.ColumnDefinitions><ColumnDefinition Width="240"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock FontFamily="Bahnschrift" FontSize="32" FontStyle="Italic" FontWeight="Bold">VERTEX<Run Foreground="#FF344C">LAB</Run></TextBlock><TextBlock Text="DESKTOP / NATIVE ALPHA" Foreground="#9E939A" FontSize="11"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="◉  LIVE" Click="LiveClicked"/><TextBox x:Name="SessionName" Width="220" ToolTip="Nombre de la próxima sesión manual"/><Button Content="● REC" Background="#A71D34" Click="RecordClicked"/><Button Content="■ Guardar" Click="StopClicked"/></StackPanel><StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock x:Name="EngineBadge" Text="CONECTANDO" VerticalAlignment="Center" Foreground="#FFB2C0" Margin="12,0"/><Button Content="⚙" AutomationProperties.Name="Configuración" Click="SettingsClicked"/></StackPanel></Grid>
<Border Grid.Row="1" Background="#171117" Padding="12" Margin="0,0,0,12"><DockPanel><TextBlock x:Name="CaptureInfo" Text="Iniciando motor independiente…"/><TextBlock DockPanel.Dock="Right" Text="VERSIÓN INTERNA · SIN CUENTAS NI NUBE" Foreground="#B4A6AF" FontSize="11" HorizontalAlignment="Right"/></DockPanel></Border>
<Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="245"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="10"><DockPanel><StackPanel DockPanel.Dock="Top"><TextBlock Text="BIBLIOTECA LOCAL" FontFamily="Bahnschrift" FontSize="17" Margin="6,3,0,12"/><Button Content="Importar .vrtx / sesión MVP" Click="ImportClicked"/><Button Content="Exportar .vrtx" Click="ExportClicked"/><TextBlock x:Name="LibraryInfo" Text="Sesiones de este dispositivo" Foreground="#A99DA6" FontSize="12" Margin="6,10"/></StackPanel><ListBox x:Name="SessionList" SelectionChanged="SessionSelected"><ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Meta.Name}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding Caption}" Foreground="#B5A8B1" FontSize="12" Margin="0,5,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox></DockPanel></Border>
<Grid Grid.Column="2"><Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="55"/></Grid.RowDefinitions>
<Border Background="#050507" BorderBrush="{StaticResource Line}" BorderThickness="1"><Grid><MediaElement x:Name="Video" LoadedBehavior="Manual" UnloadedBehavior="Close" Stretch="Uniform" MediaOpened="VideoOpened" MediaFailed="VideoFailed" MediaEnded="VideoEnded"/><TextBlock x:Name="VideoHint" Text="Selecciona una sesión o conduce con Data Out activo" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#B8A7B1" TextWrapping="Wrap" MaxWidth="360" FontSize="20" Margin="24"/><TextBlock x:Name="SessionTitle" Text="LIVE" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="16" FontFamily="Bahnschrift" FontSize="20" Background="#B009090C" Padding="8"/></Grid></Border>
<Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="2*"/><RowDefinition Height="12"/><RowDefinition Height="3*"/></Grid.RowDefinitions><Border BorderBrush="{StaticResource Line}" BorderThickness="1" Background="{StaticResource Panel}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel Margin="10" LastChildFill="False"><TextBlock Text="TELEMETRÍA" FontFamily="Bahnschrift"/><Button Content="Ver todo" Click="ResetPlots" DockPanel.Dock="Right" Padding="7,3"/></DockPanel><ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel><local:SeriesView x:Name="SpeedPlot" Height="110" Metric="speed"/><local:SeriesView x:Name="RpmPlot" Height="110" Metric="rpm"/><local:SeriesView x:Name="ThrottlePlot" Height="110" Metric="throttle"/><local:SeriesView x:Name="BrakePlot" Height="110" Metric="brake"/></StackPanel></ScrollViewer></Grid></Border><Border Grid.Row="2" BorderBrush="{StaticResource Line}" BorderThickness="1" Background="{StaticResource Panel}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel Margin="10" LastChildFill="False"><TextBlock Text="RECORRIDO" FontFamily="Bahnschrift"/><Button Content="Encuadrar" Click="FitRoute" DockPanel.Dock="Right" Padding="7,3"/></DockPanel><local:SeriesView Grid.Row="1" x:Name="Route" IsMap="True"/></Grid></Border></Grid>
<Grid Grid.Row="1" Grid.ColumnSpan="3" Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button x:Name="PlayButton" Content="▶" AutomationProperties.Name="Reproducir o pausar" Click="PlayClicked"/><Button Grid.Column="1" Content="−5 s" Click="BackClicked"/><Button Grid.Column="2" Content="+5 s" Click="ForwardClicked"/><TextBlock Grid.Column="3" x:Name="Clock" Text="0:00.000" VerticalAlignment="Center" Margin="10,0" FontFamily="Bahnschrift"/><ComboBox Grid.Column="4" x:Name="LapPicker" Width="145" Margin="8" SelectionChanged="LapSelected"/><Slider Grid.Column="5" Margin="8,0" x:Name="Timeline" Minimum="0" Maximum="1" ValueChanged="TimeChanged" VerticalAlignment="Center" IsMoveToPointEnabled="True"/><TextBlock Grid.Column="6" x:Name="DurationLabel" Text="0:00.000" VerticalAlignment="Center" Margin="10,0"/></Grid>
</Grid></Grid>
<Border Grid.Row="3" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="15" Margin="0,12,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="3*"/><ColumnDefinition Width="3*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="DIRECCIÓN / PEDALES" Foreground="#B7A8B0" FontSize="11"/><TextBlock x:Name="SteeringValue" Text="—" FontFamily="Bahnschrift" FontSize="24"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="FUERZAS G" Foreground="#B7A8B0" FontSize="11"/><TextBlock x:Name="GValue" Text="—" FontFamily="Bahnschrift" FontSize="24"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="MOTOR" Foreground="#B7A8B0" FontSize="11"/><TextBlock x:Name="MotorValue" Text="—" FontFamily="Bahnschrift" FontSize="26" Foreground="#FF9AAA"/></StackPanel><StackPanel Grid.Column="3"><TextBlock Text="NEUMÁTICOS · °C" Foreground="#B7A8B0" FontSize="11"/><TextBlock x:Name="TyreValue" Text="—" FontFamily="Bahnschrift" FontSize="21"/></StackPanel></Grid></Border>
<TextBlock Grid.Row="4" x:Name="Message" Text="Al cerrar la ventana el motor permanece en la bandeja del sistema." Foreground="#BDB0B8" FontSize="12" Margin="0,10,0,0" TextWrapping="Wrap"/>
</Grid></Window>