<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\VertexLab.Core\VertexLab.Core.csproj" />
    <ProjectReference Include="..\VertexLab.Playback\VertexLab.Playback.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

<ItemGroup><ProjectReference Include="..\VertexLab.Capture\VertexLab.Capture.csproj" ReferenceOutputAssembly="false" /></ItemGroup>
<Target Name="CopyCaptureEngine" AfterTargets="Build"><ItemGroup><CaptureFiles Include="$(MSBuildProjectDirectory)\..\VertexLab.Capture\bin\$(Configuration)\$(TargetFramework)\VertexLab.Capture.*" /></ItemGroup><Copy SourceFiles="@(CaptureFiles)" DestinationFolder="$(TargetDir)" /></Target>
<ItemGroup><Content Include="..\..\..\cars.json" Link="cars.json" CopyToOutputDirectory="PreserveNewest" /></ItemGroup>
<ItemGroup><Content Include="..\..\..\THIRD_PARTY_NOTICES.md" Link="THIRD_PARTY_NOTICES.md" CopyToOutputDirectory="PreserveNewest" /></ItemGroup>
<ItemGroup><Content Include="../../licenses/*" Link="licenses/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" /></ItemGroup>
<ItemGroup>
<Resource Include="../../../public/font-racing-*.ttf" Link="Assets/%(Filename)%(Extension)" />
<Content Include="../../../public/brand-*.png" Link="Assets/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
<Content Include="../../../public/emblem-*.svg" Link="Assets/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
<Content Include="../../../public/OFL-*.txt" Link="Assets/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
<Content Include="../../../public/LICENSE-Tabler.txt" Link="Assets/LICENSE-Tabler.txt" CopyToOutputDirectory="PreserveNewest" />
<Content Include="../../../public/LICENSE-Cardog.txt" Link="Assets/LICENSE-Cardog.txt" CopyToOutputDirectory="PreserveNewest" />
<Content Include="../../../car-brands.json" Link="car-brands.json" CopyToOutputDirectory="PreserveNewest" />
</ItemGroup>
<ItemGroup>
  <Using Remove="System.Windows.Forms" />
  <Using Remove="System.Drawing" />
</ItemGroup></Project>
